# Required secrets — do NOT commit real values.
# Inject these via CI environment variables or Maven settings.xml.

# OWASP Dependency Check NVD API key
# Obtain at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Sonatype OSS Index credentials (optional — increases rate limit)
# Register at: https://ossindex.sonatype.org/
OSS_INDEX_USERNAME=
OSS_INDEX_PASSWORD=
