# Normalize line endings on commit; check out LF everywhere
* text=auto eol=lf

# Shell scripts — LF required for execution on Linux/Mac
*.sh    text eol=lf
mvnw    text eol=lf

# Windows batch script — CRLF required
mvnw.cmd text eol=crlf

# Toolchain pin files
.sdkmanrc text eol=lf

# Source files
*.java  text eol=lf
*.xml   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.properties text eol=lf

# Binaries — no diff, no line-ending conversion
*.jar   binary
*.class binary
*.png   binary
*.jpg   binary
*.ico   binary

# Exclude dev/meta files from `git archive` exports
.claudeignore   export-ignore
.gitleaks.toml  export-ignore
.husky/         export-ignore
CLAUDE.md       export-ignore
CONTRIBUTING.md export-ignore
